require "./spec_helper"

# Checks interoperability with another implementation (libqrencode 4.1.1),
# so that bugs shared by our encoder and decoder do not go unnoticed:
#
# - the decoder reads the symbols generated by libqrencode
# - the encoder produces the identical symbol from the same segments and mask
#
# The fixtures in spec/fixtures/qrencode were generated with the commands below
# (`qrencode -m 0 -t ASCII -o <file>` plus the listed options):
#
#   qr_alphanumeric.txt      -l L 'HELLO WORLD'
#   qr_mixed_high.txt        -l H 'Goban: QR Code 2026-11-18 #42'
#   qr_v5_quartile.txt       -v 5 -l Q 'Reed-Solomon blocks of different lengths: 0123456789'
#   qr_v7_numeric.txt        -v 7 -l M '3141592653...' (see QRENCODE_FIXTURES)
#   qr_v10_byte.txt          -v 10 -l L 'The quick brown fox ...' (see QRENCODE_FIXTURES)
#   qr_kanji.txt             -k -l M, with the text converted to Shift_JIS by iconv
#   mqr_m1.txt               -M -v 1 -l L '12345'
#   mqr_m2_alphanumeric.txt  -M -v 2 -l L 'HELLO'
#   mqr_m3_numeric.txt       -M -v 3 -l M '123456789012345678'
#   mqr_m4_quartile.txt      -M -v 4 -l Q 'goban'

# Converts the ASCII output of qrencode, which draws each dark module as "##".
def load_qrencode_fixture(name : String)
  lines = File.read_lines(File.join(__DIR__, "fixtures", "qrencode", name)).reject(&.empty?)
  canvas = Goban::Canvas(UInt8).new(lines[0].size // 2, lines.size, 0)
  lines.each_with_index do |line, y|
    line.each_char.each_slice(2).with_index do |slice, x|
      canvas[x, y] = slice[0] == '#' ? 1_u8 : 0_u8
    end
  end
  canvas
end

QRENCODE_FIXTURES = {
  # file, version, EC level, text
  {"qr_alphanumeric.txt", 1, Goban::ECC::Level::Low, "HELLO WORLD"},
  {"qr_mixed_high.txt", 4, Goban::ECC::Level::High, "Goban: QR Code 2026-11-18 #42"},
  {"qr_v5_quartile.txt", 5, Goban::ECC::Level::Quartile, "Reed-Solomon blocks of different lengths: 0123456789"},
  {"qr_v7_numeric.txt", 7, Goban::ECC::Level::Medium, "31415926535897932384626433832795028841971693993751058209749445923078164062862089986280348253421170679"},
  {"qr_v10_byte.txt", 10, Goban::ECC::Level::Low, "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog."},
  {"qr_kanji.txt", 2, Goban::ECC::Level::Medium, "こんにちは、世界！漢字モード"},
}

QRENCODE_MQR_FIXTURES = {
  {"mqr_m1.txt", 1, Goban::ECC::Level::Low, "12345"},
  {"mqr_m2_alphanumeric.txt", 2, Goban::ECC::Level::Low, "HELLO"},
  {"mqr_m3_numeric.txt", 3, Goban::ECC::Level::Medium, "123456789012345678"},
  {"mqr_m4_quartile.txt", 4, Goban::ECC::Level::Quartile, "goban"},
}

module Goban
  # Encodes the segments with the given mask instead of choosing the best one,
  # so that the result can be compared with a symbol from another encoder.
  def self.encode_qr_with_mask(segments, version : QR::Version, ecl : ECC::Level, mask : QR::Mask)
    bit_stream = BitStream.new(version.max_data_bits(ecl))
    segments.each { |segment| bit_stream.append_segment_bits(segment, version) }
    bit_stream.append_terminator_bits(version, ecl)
    bit_stream.append_padding_bits(version)
    codewords = ECC::RSInflator.inflate_codewords(bit_stream.to_bytes, version, ecl)

    canvas = QR::Template.make_canvas(version)
    QR::Encoder.draw_codewords(canvas, codewords)
    QR::Template.draw_format_modules(canvas, mask, ecl)
    mask.apply_to(canvas)
    canvas.normalize
    canvas
  end

  def self.encode_mqr_with_mask(segments, version : MQR::Version, ecl : ECC::Level, mask : MQR::Mask)
    bit_stream = BitStream.new(version.max_data_bits(ecl))
    segments.each { |segment| bit_stream.append_segment_bits(segment, version) }
    bit_stream.append_terminator_bits(version, ecl)
    bit_stream.append_padding_bits(version)
    codewords = ECC::RSInflator.inflate_codewords(bit_stream.to_bytes, version, ecl)

    canvas = MQR::Template.make_canvas(version)
    MQR::Encoder.draw_codewords(canvas, codewords, version, ecl)
    MQR::Template.draw_format_modules(canvas, mask, version, ecl)
    mask.apply_to(canvas)
    canvas.normalize
    canvas
  end

  describe QR do
    QRENCODE_FIXTURES.each do |file, version, ecl, text|
      it "decodes #{file} generated by libqrencode" do
        qr = QR.decode(load_qrencode_fixture(file))
        qr.version.to_i.should eq(version)
        qr.ecl.should eq(ecl)
        qr.segments.join(&.text).should eq(text)
      end

      it "encodes the same symbol as #{file} when using the same segments and mask" do
        canvas = load_qrencode_fixture(file)
        qr = QR.decode(canvas.clone)
        encoded = Goban.encode_qr_with_mask(qr.segments, qr.version, qr.ecl, qr.mask)
        convert_canvas_to_text(encoded).should eq(convert_canvas_to_text(canvas))
      end
    end
  end

  describe MQR do
    QRENCODE_MQR_FIXTURES.each do |file, version, ecl, text|
      it "decodes #{file} generated by libqrencode" do
        qr = MQR.decode(load_qrencode_fixture(file))
        qr.version.to_i.should eq(version)
        qr.ecl.should eq(ecl)
        qr.segments.join(&.text).should eq(text)
      end

      it "encodes the same symbol as #{file} when using the same segments and mask" do
        canvas = load_qrencode_fixture(file)
        qr = MQR.decode(canvas.clone)
        encoded = Goban.encode_mqr_with_mask(qr.segments, qr.version, qr.ecl, qr.mask)
        convert_canvas_to_text(encoded).should eq(convert_canvas_to_text(canvas))
      end
    end
  end
end
